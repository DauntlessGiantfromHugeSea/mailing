# ---------------------------------------------------------------- Datenbank
DATABASE_URL="postgresql://mailing:pass@localhost:5432/mailing?schema=public"

# ------------------------------------------------------------------ Secrets
# 32-Byte-Schlüssel (64 Hex-Zeichen) für die AES-256-GCM-Feldverschlüsselung.
# Verschlüsselt werden: Kontaktdaten, SMTP-Passwörter, Hostinger-API-Token.
# ACHTUNG: Wird dieser Schlüssel geändert, sind alle bestehenden Werte
# unlesbar. Erzeugen mit:  openssl rand -hex 32
FIELD_ENCRYPTION_KEY=""

# Signaturschlüssel für die Session-Cookies (min. 32 Zeichen).
# Erzeugen mit:  openssl rand -hex 48
SESSION_SECRET=""

# ---------------------------------------------------------------------- App
# Basis-URL — wird für die Abmeldelinks in den Mails benutzt und muss von
# außen erreichbar sein, sonst funktioniert die Abmeldung nicht.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------- Hostinger-API
# Optional. Token aus dem hPanel (Konto → API). Kann auch über die
# Einstellungen in der App hinterlegt werden (dann verschlüsselt in der DB).
#
# Wofür: Postfächer als Absender einlesen, Plan-Limits ermitteln,
# SPF/DKIM/DMARC prüfen, Zustell-Logs abgleichen, Reach-Kontakte importieren.
# NICHT zum Versenden — dafür gibt es in der API keinen Endpunkt, der Versand
# läuft über SMTP (siehe „Absender“ in der App).
HOSTINGER_API_TOKEN=""

# ------------------------------------------------------------------- Worker
# Nur nötig, wenn statt des Worker-Prozesses (npm run worker) ein externer
# Cron /api/cron/tick aufrufen soll. Ohne Wert ist der Endpunkt deaktiviert.
# Erzeugen mit:  openssl rand -hex 32
CRON_SECRET=""

# ------------------------------------------------------------ Erster Admin
# Wird von `npm run db:seed` benutzt.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"
