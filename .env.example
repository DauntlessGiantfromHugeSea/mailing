# ---------------------------------------------------------------- Datenbank
DATABASE_URL="postgresql://mailing:pass@localhost:5432/mailing?schema=public"

# ------------------------------------------------------------------ Secrets
# 32-Byte-Schlüssel (64 Hex-Zeichen) für die AES-256-GCM-Feldverschlüsselung.
# Verschlüsselt werden: Kontaktdaten, SMTP-Passwörter, Hostinger-API-Token.
# ACHTUNG: Wird dieser Schlüssel geändert, sind alle bestehenden Werte
# unlesbar. Erzeugen mit:  openssl rand -hex 32
FIELD_ENCRYPTION_KEY=""

# Signaturschlüssel für die Session-Cookies (min. 32 Zeichen).
# Erzeugen mit:  openssl rand -hex 48
SESSION_SECRET=""

# ---------------------------------------------------------------------- App
# Basis-URL — wird für die Abmeldelinks in den Mails benutzt und muss von
# außen erreichbar sein, sonst funktioniert die Abmeldung nicht.
# Produktiv die öffentliche HTTPS-Adresse eintragen:
APP_URL="https://mailing.rss-fb.com"

# Domain für den Caddy-Reverse-Proxy (ohne Schema, ohne Slash).
# Nur nötig, wenn mit  --profile caddy  gestartet wird.
APP_DOMAIN="mailing.rss-fb.com"

# Port, auf dem die App am Host lauscht — nur auf 127.0.0.1 gebunden.
# Zum Debuggen oder für einen bereits vorhandenen Reverse Proxy.
APP_PORT="3000"

# ----------------------------------------------------------------- Postgres
# Nur für docker-compose. Ein langes Zufallspasswort verwenden:
#   openssl rand -hex 24
POSTGRES_PASSWORD=""
POSTGRES_USER="mailing"
POSTGRES_DB="mailing"

# ------------------------------------------------- Anmeldung mit Microsoft
# Werte aus der App-Registrierung in Microsoft Entra ID (Azure-Portal).
# Alle drei leer = Microsoft-Anmeldung ist aus, es gilt nur das Passwort.
#
# Redirect-URI, die in der App-Registrierung eingetragen werden muss:
#   https://<deine-domain>/api/auth/microsoft/callback
#
# Verzeichnis-(Mandanten-)ID. Bewusst eine konkrete GUID und nicht "common",
# damit sich nicht beliebige Microsoft-Konten anmelden können.
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Optional: nur diese Mail-Domains zulassen (kommagetrennt).
# Leer = alle Konten des Verzeichnisses dürfen sich anmelden.
MICROSOFT_ALLOWED_DOMAINS=""

# "1" = unbekannte Adressen werden automatisch als Benutzer angelegt.
# Leer/0 = es kann sich nur anmelden, wer schon ein Konto hat (sicherer).
MICROSOFT_AUTO_PROVISION=""

# Rolle für automatisch angelegte Konten: ADMIN | EDITOR | VIEWER
MICROSOFT_DEFAULT_ROLE="VIEWER"

# "false" schaltet die Anmeldung mit E-Mail und Passwort ab.
#
# ACHTUNG: erst setzen, wenn die Microsoft-Anmeldung nachweislich
# funktioniert. Sind beide Verfahren aus, kommt niemand mehr hinein - die
# Login-Seite weist dann darauf hin, aber der Zugang ist bis zur Korrektur
# der .env gesperrt.
AUTH_LOCAL_ENABLED=""

# ---------------------------------------------------------- Hostinger-API
# Optional. Token aus dem hPanel (Konto → API). Kann auch über die
# Einstellungen in der App hinterlegt werden (dann verschlüsselt in der DB).
#
# Wofür: Postfächer als Absender einlesen, Plan-Limits ermitteln,
# SPF/DKIM/DMARC prüfen, Zustell-Logs abgleichen, Reach-Kontakte importieren.
# NICHT zum Versenden — dafür gibt es in der API keinen Endpunkt, der Versand
# läuft über SMTP (siehe „Absender“ in der App).
HOSTINGER_API_TOKEN=""

# ------------------------------------------------------------------- Worker
# Nur nötig, wenn statt des Worker-Prozesses (npm run worker) ein externer
# Cron /api/cron/tick aufrufen soll. Ohne Wert ist der Endpunkt deaktiviert.
# Erzeugen mit:  openssl rand -hex 32
CRON_SECRET=""

# ------------------------------------------------- E-Mail-Verteiler (Abgleich)
# Gemeinsames Geheimnis mit dem E-Mail-Verteiler (intern.rss-fb.com/verteiler).
# Derselbe Wert steht dort als MAILING_SYNC_TOKEN in deploy/.env.
# Leer = Schnittstelle /api/integration/verteiler ist abgeschaltet.
# Erzeugen mit:  openssl rand -hex 32
VERTEILER_SYNC_TOKEN=""

# ------------------------------------------------------------ Erster Admin
# Wird von `npm run db:seed` benutzt.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"
